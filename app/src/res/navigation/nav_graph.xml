<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/inventoryFragment">

    <!-- INVENTORY -->
    <fragment
        android:id="@+id/inventoryFragment"
        android:name="com.stansa.bagtracker.ui.inventory.InventoryFragment"
        android:label="Inventaire"
        tools:layout="@layout/fragment_inventory">

        <argument
            android:name="parentId"
            app:argType="long"
            android:defaultValue="-1" />

        <action
            android:id="@+id/action_inventory_to_inventory"
            app:destination="@id/inventoryFragment" />

        <action
            android:id="@+id/action_inventory_to_detail"
            app:destination="@id/itemDetailFragment" />

        <action
            android:id="@+id/action_inventory_to_addItem"
            app:destination="@id/addItemFragment" />
    </fragment>

    <!-- DETAIL -->
    <fragment
        android:id="@+id/itemDetailFragment"
        android:name="com.stansa.bagtracker.ui.detail.ItemDetailFragment"
        android:label="Détail"
        tools:layout="@layout/fragment_item_detail">

        <argument
            android:name="itemId"
            app:argType="long" />

        <action
            android:id="@+id/action_detail_to_addItem"
            app:destination="@id/addItemFragment" />

        <action
            android:id="@+id/action_detail_to_guided"
            app:destination="@id/guidedModeFragment" />

        <action
            android:id="@+id/action_detail_to_qr"
            app:destination="@id/qrFragment" />
    </fragment>

    <!-- ADD / EDIT ITEM -->
    <fragment
        android:id="@+id/addItemFragment"
        android:name="com.stansa.bagtracker.ui.additem.AddItemFragment"
        android:label="Ajouter / Modifier"
        tools:layout="@layout/fragment_add_item">

        <argument
            android:name="parentId"
            app:argType="long"
            android:defaultValue="-1" />

        <argument
            android:name="editItemId"
            app:argType="long"
            android:defaultValue="-1" />

        <argument
            android:name="prefillBarcode"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- SEARCH -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.stansa.bagtracker.ui.search.SearchFragment"
        android:label="Recherche"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/action_search_to_detail"
            app:destination="@id/itemDetailFragment" />
    </fragment>

    <!-- FLAT LIST -->
    <fragment
        android:id="@+id/flatListFragment"
        android:name="com.stansa.bagtracker.ui.flat.FlatListFragment"
        android:label="Liste plate"
        tools:layout="@layout/fragment_flat_list">

        <action
            android:id="@+id/action_flat_list_to_detail"
            app:destination="@id/itemDetailFragment" />
    </fragment>

    <!-- STATS -->
    <fragment
        android:id="@+id/statsFragment"
        android:name="com.stansa.bagtracker.ui.stats.StatsFragment"
        android:label="Statistiques"
        tools:layout="@layout/fragment_stats" />

    <!-- GUIDED MODE -->
    <fragment
        android:id="@+id/guidedModeFragment"
        android:name="com.stansa.bagtracker.ui.guided.GuidedModeFragment"
        android:label="Mode guidé"
        tools:layout="@layout/fragment_guided_mode">

        <argument
            android:name="itemId"
            app:argType="long" />
    </fragment>

    <!-- BARCODE SCANNER -->
    <fragment
        android:id="@+id/barcodeScannerFragment"
        android:name="com.stansa.bagtracker.ui.barcode.BarcodeScannerFragment"
        android:label="Scanner"
        tools:layout="@layout/fragment_barcode_scanner">

        <action
            android:id="@+id/action_barcode_to_detail"
            app:destination="@id/itemDetailFragment" />

        <action
            android:id="@+id/action_barcode_to_addItem"
            app:destination="@id/addItemFragment" />
    </fragment>

    <!-- QR CODE -->
    <fragment
        android:id="@+id/qrFragment"
        android:name="com.stansa.bagtracker.ui.qr.QrFragment"
        android:label="QR Code"
        tools:layout="@layout/fragment_qr">

        <argument
            android:name="itemId"
            app:argType="long" />
    </fragment>

    <!-- HISTORY -->
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.stansa.bagtracker.ui.history.HistoryFragment"
        android:label="Historique"
        tools:layout="@layout/fragment_history" />

</navigation>